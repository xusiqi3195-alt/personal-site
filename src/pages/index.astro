---
const profile = {
	name: '天麒',
	initials: '天麒',
	intro: 'I build websites, automation systems, and small internet businesses.',
};

const projects = [
	{
		number: '01',
		title: 'HVAC Air Filter B2B Website',
		description:
			'A niche B2B website focused on HVAC air filters, SEO, product structure, and lead generation.',
	},
	{
		number: '02',
		title: 'Pinterest Content Automation',
		description:
			'A workflow for generating Pinterest creatives, metadata, and publishing content more efficiently.',
	},
	{
		number: '03',
		title: 'AI & Automation Tools',
		description:
			'Small tools and automation workflows built with AI, Python, and web technologies.',
	},
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={profile.intro} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{profile.name} — Building on the Internet</title>
	</head>
	<body>
		<header class="site-header">
			<a class="mark" href="#top" aria-label={`${profile.name}, back to top`}>{profile.initials}</a>
			<nav aria-label="Primary navigation">
				<a href="#about">About</a>
				<a href="#projects">Projects</a>
				<a href="#contact">Contact</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-meta">
					<p>Building on the internet</p>
				</div>

				<h1 id="hero-title" aria-label={profile.name}>
					{profile.name.split(' ').map((word) => <span>{word}</span>)}
				</h1>

				<div class="hero-footer">
					<a class="scroll-cue" href="#about">
						<span>Scroll to explore</span>
						<span aria-hidden="true">↓</span>
					</a>
					<p class="intro">{profile.intro}</p>
				</div>
			</section>

			<section class="section about" id="about" aria-labelledby="about-title">
				<div class="section-label">
					<p>01 / About</p>
				</div>
				<div class="about-content">
					<h2 id="about-title">ABOUT</h2>
					<div class="about-copy">
						<p>
							I'm Tianqi. I build websites, automation systems, and small internet businesses.
						</p>
						<p>
							My work sits at the intersection of web development, SEO, AI, automation, and online
							commerce. I like turning ideas into real projects, testing them in the market, and improving
							them based on actual feedback.
						</p>
					</div>
				</div>
			</section>

			<section class="section projects" id="projects" aria-labelledby="projects-title">
				<div class="section-heading">
					<p class="section-label">02 / Projects</p>
					<h2 id="projects-title">Selected work</h2>
				</div>

				<div class="project-list">
					{projects.map((project) => (
						<article class="project">
							<p class="project-number">{project.number}</p>
							<div class="project-main">
								<h3>{project.title}</h3>
								<p>{project.description}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="section contact" id="contact" aria-labelledby="contact-title">
				<p class="section-label">Contact</p>
				<div class="contact-content">
					<h2 id="contact-title">LET'S CONNECT</h2>
					<p class="intro">
						For projects, collaborations, or just to say hello, feel free to reach out.
					</p>
				</div>
			</section>
		</main>

		<footer>
			<p>© {currentYear} {profile.name}</p>
			<p>Designed with intention · Built with Astro</p>
			<a href="#top">Back to top ↑</a>
		</footer>
	</body>
</html>

<style>
	:root {
		--ink: #0c0c0c;
		--paper: #f4f4f0;
		--muted: #62625e;
		--line: #c7c7c1;
		font-family: Arial, Helvetica, sans-serif;
		color: var(--ink);
		background: var(--paper);
		font-synthesis: none;
	}

	* {
		box-sizing: border-box;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-size: 16px;
		line-height: 1.5;
		-webkit-font-smoothing: antialiased;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	a:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 5px;
	}

	p,
	h1,
	h2,
	h3 {
		margin: 0;
	}

	.site-header,
	.hero,
	.section,
	footer {
		width: min(100%, 1600px);
		margin-inline: auto;
		padding-inline: clamp(1.25rem, 4vw, 4.5rem);
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 5.5rem;
		border-bottom: 1px solid var(--line);
	}

	.mark {
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	nav {
		display: flex;
		gap: clamp(1.25rem, 3vw, 3.25rem);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	nav a,
	footer a {
		position: relative;
	}

	nav a::after,
	footer a::after {
		position: absolute;
		bottom: -0.3rem;
		left: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		content: '';
		transform: scaleX(0);
		transform-origin: right;
		transition: transform 180ms ease;
	}

	nav a:hover::after,
	footer a:hover::after {
		transform: scaleX(1);
		transform-origin: left;
	}

	.hero {
		display: grid;
		min-height: calc(100svh - 5.5rem);
		padding-block: 2.25rem 2rem;
		grid-template-rows: auto 1fr auto;
	}

	.hero-meta {
		display: flex;
		justify-content: space-between;
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.hero h1 {
		align-self: center;
		font-size: clamp(5rem, 17vw, 16.5rem);
		font-weight: 700;
		letter-spacing: -0.09em;
		line-height: 0.72;
		text-transform: uppercase;
	}

	.hero h1 span {
		display: block;
	}

	.hero h1 span:last-child {
		text-align: right;
	}

	.hero-footer {
		display: grid;
		align-items: end;
		grid-template-columns: 1fr minmax(18rem, 34rem);
	}

	.scroll-cue {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: fit-content;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.scroll-cue span:last-child {
		font-size: 1.1rem;
		transition: transform 180ms ease;
	}

	.scroll-cue:hover span:last-child {
		transform: translateY(0.25rem);
	}

	.intro {
		font-size: clamp(1.1rem, 1.8vw, 1.55rem);
		letter-spacing: -0.025em;
		line-height: 1.35;
	}

	.section {
		border-top: 1px solid var(--line);
		padding-block: clamp(5rem, 10vw, 9rem);
	}

	.section-label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.about {
		display: grid;
		grid-template-columns: minmax(9rem, 1fr) 3fr;
	}

	.about-content {
		display: grid;
		gap: clamp(3rem, 8vw, 9rem);
		grid-template-columns: minmax(18rem, 1.5fr) minmax(17rem, 1fr);
	}

	.about h2,
	.contact h2 {
		font-size: clamp(2.9rem, 6vw, 6.5rem);
		font-weight: 500;
		letter-spacing: -0.065em;
		line-height: 0.95;
	}

	.about-copy {
		display: grid;
		align-content: end;
		gap: 1.5rem;
		font-size: clamp(1rem, 1.25vw, 1.15rem);
		line-height: 1.65;
	}

	.section-heading {
		display: grid;
		align-items: end;
		margin-bottom: clamp(3rem, 6vw, 5rem);
		grid-template-columns: 1fr 3fr;
	}

	.section-heading h2 {
		font-size: clamp(2.6rem, 5vw, 5rem);
		font-weight: 500;
		letter-spacing: -0.06em;
		line-height: 1;
	}

	.project {
		display: grid;
		position: relative;
		align-items: start;
		gap: 1rem;
		padding-block: 2.25rem;
		border-top: 1px solid var(--line);
		grid-template-columns: 0.5fr 2.5fr 1.5fr auto;
		transition: padding 180ms ease;
	}

	.project:last-child {
		border-bottom: 1px solid var(--line);
	}

	.project:hover {
		padding-inline: 0.75rem;
	}

	.project-number,
	.project-meta {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.project-main h3 {
		margin-bottom: 0.65rem;
		font-size: clamp(1.7rem, 3vw, 3.25rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1;
	}

	.project-main p {
		max-width: 35rem;
		color: var(--muted);
	}

	.project-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 0.35rem;
	}

	.project-arrow {
		font-size: 1.5rem;
		line-height: 1;
	}

	.contact {
		display: grid;
		min-height: 75svh;
		grid-template-columns: 1fr 3fr;
	}

	.contact-content {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 5rem;
	}

	.email-link {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1rem;
		border-bottom: 2px solid var(--ink);
		font-size: clamp(1.25rem, 3vw, 2.75rem);
		letter-spacing: -0.035em;
		transition: opacity 180ms ease;
	}

	.email-link:hover {
		opacity: 0.55;
	}

	footer {
		display: grid;
		align-items: center;
		padding-block: 1.75rem;
		border-top: 1px solid var(--line);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		grid-template-columns: 1fr 1fr auto;
		text-transform: uppercase;
	}

	footer p:nth-child(2) {
		text-align: center;
	}

	@media (max-width: 800px) {
		.site-header {
			height: 4.75rem;
		}

		.hero {
			min-height: calc(100svh - 4.75rem);
		}

		.hero-meta p:last-child {
			display: none;
		}

		.hero h1 {
			font-size: clamp(4.6rem, 24vw, 9rem);
			line-height: 0.77;
		}

		.hero-footer {
			gap: 2.5rem;
			grid-template-columns: 1fr;
		}

		.intro {
			max-width: 30rem;
		}

		.about,
		.section-heading,
		.contact {
			gap: 3.5rem;
			grid-template-columns: 1fr;
		}

		.about-content {
			gap: 3rem;
			grid-template-columns: 1fr;
		}

		.about-copy {
			max-width: 34rem;
		}

		.contact {
			min-height: 70svh;
		}

		.project {
			grid-template-columns: 3rem 1fr auto;
		}

		.project-main {
			grid-column: 2;
		}

		.project-meta {
			display: block;
			grid-column: 2;
		}

		.project-meta p + p {
			margin-top: 0.4rem;
		}

		.project-arrow {
			grid-column: 3;
			grid-row: 1;
		}

		footer {
			gap: 0.7rem;
			grid-template-columns: 1fr auto;
		}

		footer p:nth-child(2) {
			display: none;
		}
	}

	@media (max-width: 480px) {
		nav {
			gap: 1rem;
			font-size: 0.65rem;
		}

		.hero {
			padding-block: 1.5rem;
		}

		.hero h1 {
			font-size: clamp(4rem, 23vw, 6.5rem);
		}

		.scroll-cue {
			display: none;
		}

		.section {
			padding-block: 4.5rem;
		}

		.about h2,
		.contact h2 {
			font-size: clamp(2.75rem, 15vw, 4.25rem);
		}

		.project {
			grid-template-columns: 2rem 1fr auto;
		}

		.email-link {
			font-size: 1.1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}

		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
		}
	}
</style>
